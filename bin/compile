#!/usr/bin/env bash

set -e

a() { sed 's/^/-----> /'; }
i() { sed 's/^/       /'; }

cd "$1"

# Package names to install
packages=(
  "libdbd-pg-perl"
  "libhtml-tagset-perl"
  "liburi-perl"
  "libhtml-parser-perl"
  "libcgi-pm-perl"
  "libfcgi0t64"
  "libfcgi-perl"
  "libcgi-fast-perl"
  "libclone-perl"
  "libdbi-perl"
  "libencode-locale-perl"
  "libfcgi-bin"
  "libhtml-template-perl"
  "libtimedate-perl"
  "libhttp-date-perl"
  "libio-html-perl"
  "liblwp-mediatypes-perl"
  "libhttp-message-perl"
  "libterm-readkey-perl"
  "postgresql-autodoc"
)

echo "Will install postgresql-autodoc and its dependencies" | i

# Install packages to custom directory in application slug
install_dir=.scalingo-buildpack-postgresql-autodoc
mkdir -p "$install_dir"

# Create a temporary directory for package downloads
download_dir=$(mktemp -d)

# Download packages
echo "Downloading Debian packages:" | a
for pkg in "${packages[@]}"; do
  echo "  * $pkg" | i
  (cd "$download_dir" && apt-get download "$pkg")
done

# Extract packages
echo "Installing Debian packages:" | a
for deb in "$download_dir"/*.deb; do
  echo "  * $(basename "$deb")" | i
  dpkg -x "$deb" "$install_dir"
done

# Clean up temporary directory
rm -rf "$download_dir"

# Create .profile.d script setting PATH, PERL5LIB and POSTGRESQL_AUTODOC_TEMPLATES_PATH
mkdir -p .profile.d
echo "PATH=/app/$install_dir/usr/bin:\$PATH" >.profile.d/postgresql-autodoc.sh
echo "export PERL5LIB=/app/$install_dir/usr/lib/x86_64-linux-gnu/perl5/5.38:\$PERL5LIB" >>.profile.d/postgresql-autodoc.sh
echo "export PERL5LIB=/app/$install_dir/usr/share/perl5:\$PERL5LIB" >>.profile.d/postgresql-autodoc.sh
echo "export POSTGRESQL_AUTODOC_TEMPLATES_PATH=/app/$install_dir/usr/share/postgresql-autodoc" >>.profile.d/postgresql-autodoc.sh

echo "Successfully installed postgresql-autodoc" | a
echo "The binaries are in /app/$install_dir/usr/bin" | i
echo
