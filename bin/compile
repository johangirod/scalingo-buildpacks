#!/usr/bin/env bash

set -e

a() { sed 's/^/-----> /'; }
i() { sed 's/^/       /'; }

cd "$1"

# Package names to install
packages=(
  "fonts-liberation"
  "fonts-liberation-sans-narrow"
  "fonts-liberation2"
  "libann0"
  "libcdt5"
  "libcgraph6"
  "libgts-0.7-5t64"
  "libpathplan4"
  "libgvc6"
  "libgvpr2"
  "liblab-gamut1"
  "libxmu6"
  "libxaw7"
  "graphviz"
  "libgts-bin"
)

echo "Will install Graphviz and its dependencies" | i

# Install packages to custom directory in application slug
install_dir=.scalingo-buildpack-graphviz
mkdir -p "$install_dir"

# Create a temporary directory for package downloads
download_dir=$(mktemp -d)

# Download packages
echo "Downloading Debian packages:" | a
for pkg in "${packages[@]}"; do
  echo "  * $pkg" | i
  (cd "$download_dir" && apt-get download "$pkg")
done

# Extract packages
echo "Installing Debian packages:" | a
for deb in "$download_dir"/*.deb; do
  echo "  * $(basename "$deb")" | i
  dpkg -x "$deb" "$install_dir"
done

# Clean up temporary directory
rm -rf "$download_dir"

# Location of shared libraries
libs_dir=$install_dir/usr/lib/x86_64-linux-gnu

# Create .profile.d script setting PATH and LD_LIBRARY_PATH
mkdir -p .profile.d
echo "PATH=/app/$install_dir/usr/bin:\$PATH" >.profile.d/graphviz.sh
echo "export LD_LIBRARY_PATH=/app/$libs_dir:\$LD_LIBRARY_PATH" >>.profile.d/graphviz.sh

# Run dot -c to configure plugins (creates config6a file)
LD_LIBRARY_PATH=$libs_dir "$install_dir"/usr/bin/dot -c

echo "Successfully installed Graphviz" | a
echo "The binaries are in /app/$install_dir/usr/bin" | i
echo
